// ~/.config/fastfetch/config.jsonc
// ×Joda™

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
				"type": "small",
				"padding": {
					"top": 1,
					"left": 1
				}
    },
    "display": {
        "constants": [
            "▞ "
        ]
    },
    "modules": [
        {
            "key": "{$1}",
            "keyColor": "38;5;8",
            "type": "host"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;1",
            "type": "wm"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;2",
            "type": "kernel"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;3",
            "type": "disk"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;4",
            "type": "memory"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;5",
            "type": "swap"
        },
        {
            "key": "{$1}",
            "keyColor": "38;5;6",
            "type": "loadavg"
        },
				{
					"key": "{$1}",
					"keyColor": "38;5;7",
					"type": "battery"
				}
    ]
}
